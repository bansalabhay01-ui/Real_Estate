# LeadOps frontend settings (optional).
# Copy to frontend/.env.local to override. Nothing here is secret: Vite puts VITE_ values into the page.

# Where the LeadOps API runs. Default: port 8000 on the machine that serves the site
# (http://localhost:8000 while developing). Set it when the API lives elsewhere, e.g. on Render.
VITE_API_URL=http://localhost:8000

# LeadOps backend settings: TEMPLATE
# Copy this file to backend/.env and fill in your own values.
# backend/.env holds secrets and is never committed; this example file is.

# ---- LLM provider ----
# Set ONE of these keys. llm_client.py picks the provider from whichever key is set.
# With no key, the assistant answers from templates, so the demo still works.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional: override the provider's default model.
# For Claude: claude-opus-5-5 (best quality, the default) or claude-haiku-5-5 (much cheaper).
LLM_MODEL=

# Optional: auto (the first key that is set), anthropic, gemini, groq, or none (template answers only).
LLM_PROVIDER=auto

# ---- Database ----
# SQLite file while developing. For deployment, use the Postgres URL from Neon or Supabase.
DATABASE_URL=sqlite:///./leadops.db

# ---- Web ----
# Sites allowed to call the API from a browser, comma-separated. "*" lets the SDK run on any site.
CORS_ORIGINS=*
